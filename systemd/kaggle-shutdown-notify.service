[Unit]
Description=Notify Telegram when kaggle-agent machine shuts down
DefaultDependencies=no
Before=halt.target poweroff.target reboot.target shutdown.target
After=network.target

[Service]
Type=oneshot
User=keehar
ExecStart=/home/keehar/kaggle-agent/scripts/notify_shutdown.sh
TimeoutStartSec=10
RemainAfterExit=no

[Install]
WantedBy=halt.target poweroff.target reboot.target shutdown.target
