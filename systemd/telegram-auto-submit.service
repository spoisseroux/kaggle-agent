[Unit]
Description=Telegram Auto-Submit Daemon for Kaggle Agent
After=network.target

[Service]
Type=simple
User=keehar
WorkingDirectory=/home/keehar/kaggle-agent
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/keehar/kaggle-venv/bin/python /home/keehar/kaggle-agent/scripts/telegram_auto_submit.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/telegram-auto-submit.log
StandardError=append:/var/log/telegram-auto-submit.log

[Install]
WantedBy=default.target
