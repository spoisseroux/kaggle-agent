[Unit]
Description=Kaggle Agent Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keehar
Group=keehar
WorkingDirectory=/home/keehar/kaggle-agent
EnvironmentFile=/home/keehar/kaggle-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/keehar/kaggle-venv/bin/python /home/keehar/kaggle-agent/core/telegram_bot.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/keehar/kaggle-agent/logs/telegram-bot.log
StandardError=append:/home/keehar/kaggle-agent/logs/telegram-bot.log

[Install]
WantedBy=multi-user.target
